# Names only. Real values go in .env.local (git-ignored) and Vercel env vars.
# Analytics (Google Tag Manager container, looks like GTM-XXXXXXX). Leave empty until Alan has one: no banner, nothing loads.
NEXT_PUBLIC_GTM_ID=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Later phases
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=
RESEND_API_KEY=

# Optional: random text used to scramble network addresses for rate limiting (falls back to the service key)
RATE_LIMIT_SALT=

# Leave unset until Alan approves going live
ALLOW_INDEXING=
